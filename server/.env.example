# Absolute path to the folder containing your MP4 files
MEDIA_DIR=/absolute/path/to/your/viofo/videos

# IANA timezone used by the clock embedded in dashcam filenames
DASHCAM_TIME_ZONE=Etc/GMT-2

# Server options
PORT=5174

# If serving the web build from the server
SERVE_WEB=true

# Authentication options
AUTH_ENABLED=true
AUTHENTIK_ISSUER=https://your-authentik.local/application/o/dashcam-viewer/
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
AUTHENTIK_REDIRECT_URI=http://localhost:5174/api/auth/callback
SESSION_SECRET=dev-secret-change-in-production
